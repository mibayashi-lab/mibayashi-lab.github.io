---
import { siteData } from '../data/site';
import { getCollection } from 'astro:content';

const currentYear = new Date().getFullYear();
const latestPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const formatPostDate = (date: Date) => date.toISOString().slice(0, 10);
const memberGroups = [
  { title: '教員', titleEn: 'Faculty', members: siteData.members.filter((member) => member.role === 'Principal Investigator') },
  { title: '学生', titleEn: 'Students', members: siteData.members.filter((member) => member.role.startsWith('Student')) },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${siteData.affiliation} ${siteData.name}。自然言語処理・情報検索・創造的テキスト生成を研究しています。`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{siteData.name} | {siteData.affiliation}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#top" aria-label={`${siteData.name} トップ`}>
          <span class="brand-mark">M</span>
          <span class="brand-copy">
            <strong>{siteData.name}</strong>
            <small>{siteData.nameEn}</small>
          </span>
        </a>
        <nav aria-label="メインナビゲーション">
          <a href="/posts/">Posts</a>
          <a href="#about">About</a>
          <a href="/research/">Research</a>
          <a href="#projects">Themes</a>
          <a href="#members">Members</a>
          <a class="nav-contact" href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-orbit orbit-one" aria-hidden="true"></div>
        <div class="hero-orbit orbit-two" aria-hidden="true"></div>
        <div class="shell hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">KOBE UNIVERSITY · INTERCULTURAL STUDIES</p>
            <h1><span>神戸大学</span><span>三林研究室</span></h1>
            <p class="hero-en">{siteData.taglineEn}</p>
            <a class="hero-link" href="#about">研究室について <span aria-hidden="true">↘</span></a>
          </div>
          <div class="hero-index" aria-label="研究分野">
            <span>FIELD INDEX</span>
            <ol>
              <li><b>01</b> Language</li>
              <li><b>02</b> Retrieval</li>
              <li><b>03</b> Creativity</li>
              <li><b>04</b> Interaction</li>
            </ol>
          </div>
        </div>
      </section>

      <section id="news" class="news section-pad">
        <div class="shell section-grid">
          <header class="section-label"><span>NEWS</span><h2>News</h2></header>
          <div class="news-list">
            {latestPosts.map((post) => (
              <article class="news-item">
                <time datetime={formatPostDate(post.data.date)}>{formatPostDate(post.data.date).replaceAll('-', '.')}</time>
                <span>{post.data.category}</span>
                <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="about section-pad">
        <div class="shell section-grid">
          <header class="section-label">
            <span>00</span>
            <h2>About us</h2>
          </header>
          <div class="about-body">
            <p class="about-lead">{siteData.introduction}</p>
            <div class="about-meta">
              <div><span>Affiliation</span><strong>{siteData.affiliation}</strong></div>
              <div><span>Focus</span><strong>NLP / IR / HCI / Music</strong></div>
            </div>
          </div>
        </div>
      </section>

      <section id="research" class="research section-pad dark-section">
        <div class="shell">
          <header class="section-head light-head">
            <div class="section-label"><span>01</span><h2>Research</h2></div>
            <p>複数の領域を横断し、言葉と情報をめぐる問いに取り組みます。</p>
          </header>
          <div class="research-list">
            {siteData.research.map((item) => (
              <article class="research-item">
                <span class="research-number">{item.number}</span>
                <div>
                  <p class="research-en">{item.titleEn}</p>
                  <h3>{item.title}</h3>
                </div>
                <p class="research-description">{item.description}</p>
                <ul>{item.keywords.map((keyword) => <li>{keyword}</li>)}</ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="projects" class="projects section-pad">
        <div class="shell">
          <header class="section-head">
            <div class="section-label"><span>02</span><h2>Research themes</h2></div>
          </header>
          <div class="project-grid">
            {siteData.projects.map((project, index) => (
              <article class:list={['project-card', index === 0 && 'project-featured']}>
                <div class="project-image-wrap">
                  <img src={project.image} alt="" class="project-image" loading="lazy" />
                  <span>{String(index + 1).padStart(2, '0')}</span>
                </div>
                <div class="project-copy">
                  <p>{project.year}</p>
                  <h3>{project.title}</h3>
                  <div class="project-description">{project.description}</div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="members" class="members section-pad soft-section">
        <div class="shell">
          <header class="section-head">
            <div class="section-label"><span>03</span><h2>Members</h2></div>
          </header>
          <div class="member-groups">
            {memberGroups.map((group) => (
              <section class="member-group" aria-labelledby={`member-${group.titleEn.toLowerCase()}`}>
                <header class="member-subhead" id={`member-${group.titleEn.toLowerCase()}`}>
                  <span>{group.titleEn}</span>
                  <h3>{group.title}</h3>
                </header>
                <div class="member-grid">
                  {group.members.map((member) => (
                    <article class="member-card">
                      <div class="member-image-wrap">
                        <img src={member.image} alt={`${member.name}のプロフィール画像`} loading="lazy" />
                        <span>{member.role}</span>
                      </div>
                      <div class="member-copy">
                        <p>{member.position}</p>
                        <h3>{member.name}</h3>
                        <span>{member.nameEn}</span>
                        <div class="member-comment">{member.comment}</div>
                        {'profile' in member && <a href={member.profile} target="_blank" rel="noopener noreferrer">researchmap ↗</a>}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="contact section-pad dark-section">
        <div class="shell contact-grid">
          <div>
            <p class="eyebrow">CONTACT / COLLABORATION</p>
            <h2>研究・共同研究<br />について</h2>
          </div>
          <div class="contact-details">
            <p>研究相談・共同研究などについては、以下の連絡先またはresearchmapをご確認ください。</p>
            <dl>
              <div><dt>Campus</dt><dd>{siteData.contact.campus}</dd></div>
              <div><dt>Address</dt><dd>{siteData.contact.address}</dd></div>
              <div><dt>Email</dt><dd>{siteData.contact.email}</dd></div>
            </dl>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <div><strong>{siteData.name}</strong><span>{siteData.nameEn}</span></div>
        <ul>{siteData.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a></li>)}</ul>
        <small>© {currentYear} Mibayashi Lab.</small>
      </div>
    </footer>
  </body>
</html>

<style>
  html { zoom: .9; }

  :root {
    --ink: #101820;
    --ink-soft: #29343d;
    --paper: #f4f2eb;
    --white: #ffffff;
    --acid: #d8ff3e;
    --violet: #8d7cff;
    --line: rgba(16, 24, 32, 0.18);
    --sans: "Noto Sans JP", "DM Sans", sans-serif;
    --latin: "DM Sans", "Noto Sans JP", sans-serif;
    --mono: "IBM Plex Mono", "Noto Sans JP", monospace;
    --shell: 1200px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 86px; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 17.78px; line-height: 1.75; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  .shell { width: min(calc(100% - 48px), var(--shell)); margin-inline: auto; }
  .section-pad { padding: 112px 0; }

  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid rgba(255,255,255,.14); background: rgba(16,24,32,.92); color: white; backdrop-filter: blur(16px); }
  .header-inner { min-height: 74px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-mark { display: grid; place-items: center; width: 38px; height: 38px; background: var(--acid); color: var(--ink); font: 800 20px/1 var(--latin); }
  .brand-copy { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-copy strong { font-size: 17px; }
  .brand-copy small { margin-top: 4px; color: #9ba6ae; font: 500 10px/1 var(--mono); text-transform: uppercase; letter-spacing: .1em; }
  nav { display: flex; align-items: center; gap: 28px; font: 500 18px/1 var(--latin); }
  nav a { color: #c3cbd0; transition: color .2s; }
  nav a:hover { color: var(--acid); }
  nav .nav-contact { padding: 12px 16px; border: 1px solid #69737a; color: white; }

  .hero { position: relative; min-height: 710px; overflow: hidden; background: var(--ink); color: white; }
  .hero-grid { position: absolute; inset: 0; opacity: .18; background-image: linear-gradient(rgba(255,255,255,.15) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.15) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to bottom, black, transparent 92%); }
  .hero-orbit { position: absolute; border: 1px solid rgba(216,255,62,.35); border-radius: 50%; }
  .orbit-one { width: 680px; height: 680px; right: -140px; top: 30px; }
  .orbit-two { width: 420px; height: 420px; right: -10px; top: 160px; border-color: rgba(141,124,255,.45); }
  .hero-inner { position: relative; min-height: 710px; display: grid; grid-template-columns: 1fr 260px; align-items: center; gap: 80px; padding-top: 54px; }
  .eyebrow { margin: 0 0 28px; color: var(--acid); font: 500 11px/1.4 var(--mono); letter-spacing: .1em; }
  .hero h1 { margin: 0; font-size: clamp(54px, 7.5vw, 108px); line-height: 1.04; letter-spacing: -.065em; }
  .hero h1 span { display: block; }
  .hero-en { margin: 28px 0 40px; color: #aab4bb; font: 400 clamp(17px, 2vw, 24px)/1.5 var(--latin); }
  .hero-link { display: inline-flex; gap: 48px; align-items: center; padding: 16px 0; border-bottom: 1px solid #78838a; font-weight: 600; }
  .hero-link span { color: var(--acid); font-size: 20px; }
  .hero-index { align-self: end; margin-bottom: 70px; padding: 20px; border: 1px solid rgba(255,255,255,.18); background: rgba(16,24,32,.65); backdrop-filter: blur(8px); }
  .hero-index > span { color: #8f9aa2; font: 500 10px/1 var(--mono); letter-spacing: .1em; }
  .hero-index ol { margin: 18px 0 0; padding: 0; list-style: none; }
  .hero-index li { display: flex; gap: 18px; padding: 9px 0; border-top: 1px solid rgba(255,255,255,.12); font: 500 12px/1.2 var(--mono); }
  .hero-index b { color: var(--acid); }

  .section-grid { display: grid; grid-template-columns: 230px 1fr; gap: 90px; }
  .section-label { display: flex; gap: 14px; align-items: baseline; }
  .section-label span { color: #6e777c; font: 500 11px/1 var(--mono); }
  .section-label h2 { margin: 0; font: 700 24px/1.1 var(--latin); letter-spacing: -.03em; }
  .about-lead { max-width: 850px; margin: 0; font-size: clamp(24px, 3vw, 40px); font-weight: 600; line-height: 1.65; letter-spacing: -.035em; }
  .about-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-top: 64px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .about-meta div { padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .about-meta span { display: block; margin-bottom: 10px; color: #757e83; font: 500 10px/1 var(--mono); text-transform: uppercase; }
  .about-meta strong { font-size: 14px; }

  .dark-section { background: var(--ink); color: white; }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 40px; margin-bottom: 54px; }
  .section-head > p { max-width: 520px; margin: 0; color: #687177; font-size: 14px; }
  .light-head > p { color: #9da7ad; }
  .research-list { border-top: 1px solid rgba(255,255,255,.22); }
  .research-item { display: grid; grid-template-columns: 70px 1.15fr 1fr 210px; gap: 32px; align-items: center; padding: 34px 0; border-bottom: 1px solid rgba(255,255,255,.22); transition: padding .25s, background .25s; }
  .research-item:hover { padding-inline: 18px; background: rgba(216,255,62,.05); }
  .research-number { color: var(--acid); font: 500 12px/1 var(--mono); }
  .research-en { margin: 0 0 6px; color: #89959c; font: 500 10px/1 var(--mono); text-transform: uppercase; letter-spacing: .05em; }
  .research-item h3 { margin: 0; font-size: 25px; }
  .research-description { margin: 0; color: #b6c0c6; font-size: 14px; }
  .research-item ul { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .research-item li { padding: 5px 9px; border: 1px solid #4c585f; color: #c4ccd1; font: 500 10px/1 var(--mono); }

  .project-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 76px 28px; }
  .project-card { min-width: 0; }
  .project-card:nth-child(even) { margin-top: 90px; }
  .project-image-wrap { position: relative; aspect-ratio: 4/3; overflow: hidden; background: #dfe2dc; }
  .project-image { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .project-card:hover .project-image { transform: scale(1.025); }
  .project-image-wrap > span { position: absolute; right: 0; bottom: 0; padding: 9px 12px; background: var(--acid); font: 600 11px/1 var(--mono); }
  .project-copy { display: grid; grid-template-columns: 130px 1fr; gap: 16px; margin-top: 20px; }
  .project-copy > p { margin: 5px 0 0; color: #6f787d; font: 500 10px/1.4 var(--mono); text-transform: uppercase; }
  .project-copy h3 { margin: 0; font-size: 20px; line-height: 1.45; }
  .project-description { grid-column: 2; color: #687177; font-size: 13px; }

  .soft-section { background: #e8e9e4; }
  .member-groups { display: grid; gap: 58px; }
  .member-subhead { display: flex; align-items: baseline; gap: 14px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .member-subhead span { color: #687177; font: 500 10px/1 var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .member-subhead h3 { margin: 0; font-size: 20px; line-height: 1.2; }
  .member-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .member-card { background: var(--paper); border: 1px solid var(--line); }
  .member-image-wrap { position: relative; aspect-ratio: 1; overflow: hidden; background: white; }
  .member-image-wrap img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.8); transition: filter .25s, transform .35s; }
  .member-card:hover img { filter: saturate(1); transform: scale(1.02); }
  .member-image-wrap span { position: absolute; left: 12px; top: 12px; padding: 6px 8px; background: var(--ink); color: white; font: 500 9px/1 var(--mono); text-transform: uppercase; }
  .member-copy { padding: 17px; }
  .member-copy > p { margin: 0 0 6px; color: #687177; font-size: 11px; }
  .member-copy h3 { display: inline; margin: 0; font-size: 18px; }
  .member-copy > span { margin-left: 8px; color: #7a8388; font: 400 10px/1 var(--mono); }
  .member-comment { min-height: 42px; margin-top: 12px; color: #5c666b; font-size: 12px; }
  .member-copy a { display: inline-block; margin-top: 15px; border-bottom: 1px solid var(--ink); font: 500 11px/1.6 var(--mono); }

  .news-list { border-top: 1px solid var(--line); }
  .news-item { display: grid; grid-template-columns: 130px 90px 1fr; gap: 24px; align-items: center; padding: 23px 0; border-bottom: 1px solid var(--line); }
  .news-item time, .news-item span { color: #697277; font: 500 11px/1 var(--mono); }
  .news-item span { width: max-content; padding: 5px 8px; border: 1px solid var(--line); }
  .news-item h3 { margin: 0; font-size: 15px; font-weight: 500; }

  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
  .contact h2 { margin: 0; font-size: clamp(40px, 5vw, 68px); line-height: 1.3; letter-spacing: -.05em; }
  .contact-details > p { margin: 0 0 38px; color: #aab4ba; }
  .contact-details dl { margin: 0; border-top: 1px solid #4a555c; }
  .contact-details dl div { display: grid; grid-template-columns: 90px 1fr; gap: 24px; padding: 18px 0; border-bottom: 1px solid #4a555c; }
  .contact-details dt { color: var(--acid); font: 500 10px/1.6 var(--mono); text-transform: uppercase; }
  .contact-details dd { margin: 0; color: #d0d7db; font-size: 13px; }

  footer { background: #080d11; color: white; padding: 50px 0; }
  .footer-inner { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end; }
  .footer-inner > div { display: flex; flex-direction: column; }
  .footer-inner strong { font-size: 22px; }
  .footer-inner span { color: #7e898f; font: 500 11px/1.8 var(--mono); }
  .footer-inner ul { display: flex; gap: 24px; margin: 0; padding: 0; list-style: none; font: 500 10px/1 var(--mono); }
  .footer-inner a:hover { color: var(--acid); }
  .footer-inner small { grid-column: 1 / -1; padding-top: 28px; border-top: 1px solid #30393e; color: #778187; font: 400 10px/1 var(--mono); }

  @media (max-width: 900px) {
    nav a:not(.nav-contact) { display: none; }
    .hero-inner { grid-template-columns: 1fr; min-height: 650px; }
    .hero-index { display: none; }
    .section-grid { grid-template-columns: 1fr; gap: 42px; }
    .research-item { grid-template-columns: 50px 1fr; }
    .research-description, .research-item ul { grid-column: 2; justify-content: flex-start; }
    .member-grid { grid-template-columns: 1fr 1fr; }
    .contact-grid { grid-template-columns: 1fr; gap: 58px; }
  }

  @media (min-width: 901px) and (max-width: 1100px) {
    .member-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 620px) {
    .shell { width: min(calc(100% - 32px), var(--shell)); }
    .section-pad { padding: 78px 0; }
    .brand-copy small { display: none; }
    .hero, .hero-inner { min-height: 590px; }
    nav .nav-contact { display: block; padding: 10px 12px; }
    .hero h1 { font-size: clamp(42px, 12vw, 52px); overflow-wrap: anywhere; }
    .hero h1 span { display: block; }
    .section-head { align-items: flex-start; flex-direction: column; margin-bottom: 38px; }
    .about-meta, .project-grid, .member-grid { grid-template-columns: 1fr; }
    .project-card:nth-child(even) { margin-top: 0; }
    .project-copy { grid-template-columns: 1fr; }
    .project-description { grid-column: 1; }
    .research-item { gap: 18px; padding: 28px 0; }
    .research-item h3 { font-size: 20px; }
    .news-item { grid-template-columns: 1fr auto; gap: 12px; }
    .news-item h3 { grid-column: 1 / -1; }
    .footer-inner { grid-template-columns: 1fr; }
    .footer-inner ul { flex-direction: column; gap: 14px; }
  }

  /* Homepage refresh: a quieter, paper-like palette aligned with the Research page. */
  .site-header { background: rgba(225,233,246,.94); color: #1e2c43; border-bottom-color: #becbe0; backdrop-filter: blur(12px); }
  .brand-mark { background: #263752; color: #fff; }
  .brand-copy strong { color: #1e2c43; }
  .brand-copy small { color: #66758c; }
  nav a { color: #40516a; }
  nav a:hover { color: #14233a; }
  nav .nav-contact { color: #fff; border-color: #263752; background: #263752; }
  nav .nav-contact:hover { color: #263752; background: #fff; }

  .hero { min-height: 600px; background: #fff; color: #151515; border-bottom: 1px solid #dedede; }
  .hero-grid { opacity: .38; background-image: linear-gradient(#ececec 1px, transparent 1px), linear-gradient(90deg, #ececec 1px, transparent 1px); }
  .hero-orbit { opacity: 1; border: 0; filter: blur(1px); }
  .orbit-one { width: 390px; height: 390px; right: 5%; top: 8%; background: rgba(191, 211, 255, .7); }
  .orbit-two { width: 260px; height: 260px; right: 22%; bottom: -15%; background: rgba(255, 221, 153, .65); }
  .hero-inner { min-height: 600px; }
  .hero .eyebrow { color: #555; }
  .hero h1 { color: #111; }
  .hero-en { color: #666; }
  .hero-link { color: #111; border-bottom-color: #111; }
  .hero-index { background: rgba(255,255,255,.86); color: #111; border: 1px solid #d7d7d7; box-shadow: 12px 12px 0 #f2c7d2; }
  .hero-index > span { color: #666; }
  .hero-index li { border-top-color: #d7d7d7; }
  .hero-index b { color: #536ca9; }

  .news { background: #f5f7fb; }
  .news .section-label span { color: #536ca9; }
  .news-list { border-top-color: #cfd4dd; }
