---
import { publications, publicationGroups } from '../data/publications';
import { siteData } from '../data/site';

const groupedPublications = publicationGroups.map((group) => ({
  ...group,
  items: publications.filter((publication) => publication.type === group.key),
}));

---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${siteData.name}の研究成果・論文一覧`} />
    <link rel="icon" type="image/jpeg" href="/images/fav.jfif" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Publications | {siteData.name}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label={`${siteData.name} トップ`}>
          <img class="brand-mark" src="/images/fav.jfif" alt="" />
          <span class="brand-copy"><strong>{siteData.name}</strong><small>{siteData.nameEn}</small></span>
        </a>
        <nav aria-label="メインナビゲーション">
          <a href="/#about">About</a>
          <a href="/#research">Research</a>
          <a href="/#members">Members</a>
          <a href="/publications/">Publications</a>
          <a href="/posts/">Posts</a>
          <a href="/fps/">For Students</a>
          <a class="nav-contact" href="/#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="page-hero">
        <div class="grid" aria-hidden="true"></div>
        <div class="orb orb-blue" aria-hidden="true"></div>
        <div class="orb orb-yellow" aria-hidden="true"></div>
        <div class="shell hero-inner">
          <p>RESEARCH / OUTPUT</p>
          <h1>Publications</h1>
          <div>三林研究室に関わる研究成果を、発表形態ごとにまとめています。<span class="hero-count">全{publications.length}件</span></div>
        </div>
      </section>

      <section class="page-section">
        <div class="shell">
          <p class="source-note">書誌情報の詳細は <a href="https://researchmap.jp/ryotamibayashi" target="_blank" rel="noopener noreferrer">三林亮太のresearchmap ↗</a> もご覧ください。</p>

          <nav class="section-nav" aria-label="研究成果の分類">
          {groupedPublications.map((group) => <a href={`#${group.key}`}>{group.title}</a>)}
          </nav>

          <div class="publication-groups">
          {groupedPublications.map((group) => (
            <section id={group.key} class="publication-group">
              <div class="group-heading">
                <h2>{group.title}<span class="group-count">{group.items.length}件</span></h2>
              </div>
              {group.items.length > 0 ? <ol class="publication-list">
                {group.items.map((publication) => (
                  <li class="publication-item">
                    <div class="publication-meta">
                      <div class="publication-year">{publication.year}</div>
                      {publication.refereed && <span class="publication-tag">査読あり</span>}
                    </div>
                    <div class="publication-body">
                      <h3>{publication.title}</h3>
                      <p class="authors">{publication.authors}</p>
                      <p class="venue">{publication.venue}</p>
                    </div>
                  </li>
                ))}
              </ol> : <p class="empty-group">researchmap上、現在掲載対象の国内会議の成果はありません。</p>}
            </section>
          ))}
          </div>
        </div>
      </section>
    </main>

    <footer><div class="shell footer-inner"><strong>{siteData.name}</strong><span>{siteData.contact.email}</span></div></footer>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  :root { --ink: #151515; --navy: #263752; --header: #e1e9f6; --line: #cbd2dc; --shell: 1200px; --sans: "Noto Sans JP", "DM Sans", sans-serif; --latin: "DM Sans", "Noto Sans JP", sans-serif; --mono: "IBM Plex Mono", "Noto Sans JP", monospace; }
  html { zoom: .9; background: #eef2f8; color: var(--ink); font-family: var(--sans); font-size: 16px; line-height: 1.75; }
  body { margin: 0; font-size: 17.78px; }
  a { color: #536ca9; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .shell { width: min(calc(100% - 48px), var(--shell)); margin-inline: auto; }
  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid #becbe0; background: rgba(225,233,246,.94); backdrop-filter: blur(12px); }
  .header-inner { min-height: 74px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-mark { display: block; width: 38px; height: 38px; object-fit: cover; }
  .brand-copy { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-copy strong { color: #1e2c43; font-size: 17px; }
  .brand-copy small { margin-top: 4px; color: #66758c; font: 500 10px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  nav { display: flex; align-items: center; gap: 28px; font: 500 18px/1 var(--latin); }
  nav a { color: #40516a; }
  nav a:hover, nav a[aria-current="page"] { color: #14233a; }
  nav a[aria-current="page"] { border-bottom: 1px solid #14233a; }
  nav .nav-contact { padding: 12px 16px; border: 1px solid var(--navy); background: var(--navy); color: white; }
  .page-hero { position: relative; min-height: 420px; overflow: hidden; background: linear-gradient(#f8f9fc, #eef2f8); }
  .grid { position: absolute; inset: 0; opacity: .42; background-image: linear-gradient(#e4e8ef 1px, transparent 1px), linear-gradient(90deg, #e4e8ef 1px, transparent 1px); background-size: 72px 72px; }
  .orb { position: absolute; border-radius: 50%; }
  .orb-blue { width: 330px; height: 330px; right: 6%; top: 30px; background: rgba(191,211,255,.72); }
  .orb-yellow { width: 210px; height: 210px; right: 23%; bottom: -50px; background: rgba(255,221,153,.62); }
  .hero-inner { position: relative; z-index: 1; padding-top: 88px; }
  .hero-inner > p { margin: 0 0 14px; color: #536ca9; font: 500 11px/1.4 var(--mono); letter-spacing: .1em; }
  .hero-inner h1 { margin: 0; color: #151515; font: 500 clamp(58px, 7vw, 92px)/1 var(--latin); letter-spacing: -.055em; }
  .hero-inner > div { max-width: 650px; margin-top: 30px; color: #515b68; font-size: 17px; }
  .hero-count { display: inline-block; margin-left: 14px; color: #536ca9; font: 500 12px/1 var(--mono); letter-spacing: .08em; }
  .page-section { padding: 88px 0 120px; background: #fff; }
  .source-note { margin: 0; color: #69788e; font-size: 14px; }
  .section-nav { position: sticky; top: 0; z-index: 3; justify-content: flex-start; gap: 10px; margin: 58px 0 72px; padding: 12px 8px; border-top: 1px solid #bcc9dd; border-bottom: 1px solid #bcc9dd; background: rgba(245,247,251,.88); backdrop-filter: blur(12px); }
  .section-nav a { padding: 4px 12px; border: 1px solid #aebdd5; border-radius: 999px; color: #40516a; font-size: 13px; }
  .section-nav a:hover { background: #e1e9f6; text-decoration: none; }
  .publication-group + .publication-group { margin-top: 88px; }
  .group-heading { display: flex; align-items: baseline; gap: 20px; margin-bottom: 18px; }
  h2 { margin: 0; color: #1e2c43; font-size: clamp(28px, 4vw, 46px); font-weight: 500; line-height: 1.25; letter-spacing: -1px; }
  .group-count { margin-left: 12px; color: #536ca9; font: 500 14px/1 var(--mono); letter-spacing: .04em; vertical-align: middle; }
  .publication-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid #bcc9dd; }
  .publication-item { display: grid; grid-template-columns: 80px 1fr; gap: 30px; padding: 28px 0 30px; border-bottom: 1px solid #d2dbe8; }
  .publication-meta { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .publication-year { padding-top: 4px; }
  .publication-tag { padding: 3px 7px; border: 1px solid #9fb9a7; border-radius: 999px; background: #edf7ef; color: #41664b; font: 500 10px/1 var(--mono); white-space: nowrap; }
  .publication-body { max-width: 900px; }
  h3 { margin: 0 0 10px; color: #19263a; font-size: 21px; font-weight: 600; line-height: 1.5; }
  .authors, .venue { margin: 0; color: #4b5a70; font-size: 14px; }
  .venue { margin-top: 4px; color: #6c788b; font-style: italic; }
  .empty-group { margin: 0; padding: 28px 0; border-top: 1px solid #bcc9dd; border-bottom: 1px solid #d2dbe8; color: #69788e; }
  footer { margin-top: 0; padding: 34px 0; border-top: 1px solid #263752; background: #151515; color: #b9c1ca; font-size: 13px; }
  .footer-inner { display: flex; justify-content: space-between; }
  @media (max-width: 900px) { nav a:not(.nav-contact) { display: none; } }
  @media (max-width: 640px) {
    .shell { width: min(calc(100% - 32px), var(--shell)); }
    .page-hero { min-height: 350px; }
    .hero-inner { padding-top: 68px; }
    .header-inner { min-height: 64px; }
    .hero-inner h1 { font-size: 58px; letter-spacing: -.04em; }
    .page-section { padding: 60px 0 84px; }
    .section-nav { margin: 42px 0 54px; overflow-x: auto; white-space: nowrap; }
    .publication-item { grid-template-columns: 1fr; gap: 5px; padding: 23px 0 26px; }
    .publication-meta { flex-direction: row; align-items: center; }
    .publication-year { padding-top: 0; }
    h3 { font-size: 18px; }
    .footer-inner { flex-direction: column; gap: 5px; }
  }
</style>
