---
import { publications, publicationGroups } from '../data/publications';
import { siteData } from '../data/site';

const groupedPublications = publicationGroups.map((group) => ({
  ...group,
  items: publications.filter((publication) => publication.type === group.key),
}));
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${siteData.name}の研究成果・論文一覧`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Publications | {siteData.name}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-bar"></div>
      <div class="header-wrapper">
        <a class="site-title" href="/">神戸大学 三林研究室</a>
        <nav aria-label="メインナビゲーション">
          <a href="/#about">About</a>
          <a href="/#projects">Themes</a>
          <a href="/#members">Members</a>
          <a aria-current="page" href="/publications/">Publications</a>
          <a href="/posts/">Posts</a>
          <a href="/fps/">For Students</a>
          <a href="/#contact">Contact Us</a>
        </nav>
      </div>
    </header>

    <main class="page-content">
      <article>
        <header class="page-heading">
          <p class="eyebrow">Research output / {publications.length} records</p>
          <h1>Publications</h1>
          <p class="lead">三林研究室に関わる研究成果を、発表形態ごとにまとめています。</p>
          <p class="source-note">書誌情報の詳細は <a href="https://researchmap.jp/ryotamibayashi" target="_blank" rel="noopener noreferrer">三林亮太のresearchmap ↗</a> もご覧ください。</p>
        </header>

        <nav class="section-nav" aria-label="研究成果の分類">
          {groupedPublications.map((group) => <a href={`#${group.key}`}>{group.title}</a>)}
        </nav>

        <div class="publication-groups">
          {groupedPublications.map((group) => (
            <section id={group.key} class="publication-group">
              <div class="group-heading">
                <span class="group-index">{String(groupedPublications.indexOf(group) + 1).padStart(2, '0')}</span>
                <h2>{group.title}</h2>
              </div>
              <ol class="publication-list">
                {group.items.map((publication) => (
                  <li class="publication-item">
                    <div class="publication-year">{publication.year}</div>
                    <div class="publication-body">
                      <h3>{publication.title}</h3>
                      <p class="authors">{publication.authors}</p>
                      <p class="venue">{publication.venue}</p>
                      {publication.link && <a class="publication-link" href={publication.link} target="_blank" rel="noopener noreferrer">{publication.linkLabel ?? '詳細'} <span aria-hidden="true">↗</span></a>}
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </article>
    </main>

    <footer><div class="footer-wrapper"><span>神戸大学 三林研究室</span><span>{siteData.contact.email}</span></div></footer>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html { background: #e8edf8; color: #151515; font-family: "Noto Sans JP", "DM Sans", sans-serif; font-size: 16px; line-height: 1.75; }
  body { margin: 0; border-top: 4px solid #263752; background: #f5f7fb; }
  a { color: #536ca9; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .site-header { position: relative; min-height: 64px; border-bottom: 1px solid #becbe0; background: rgba(225,233,246,.94); backdrop-filter: blur(12px); }
  .header-wrapper { width: min(calc(100% - 64px), 1200px); min-height: 64px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
  .site-title { color: #1e2c43; font-size: 18px; font-weight: 700; letter-spacing: -.5px; }
  .site-title:hover { text-decoration: none; }
  nav { display: flex; gap: 25px; }
  nav a { color: #40516a; font-family: "DM Sans", "Noto Sans JP", sans-serif; font-size: 16px; font-weight: 500; }
  nav a:hover, nav a[aria-current="page"] { color: #14233a; }
  .page-content { position: relative; padding: 70px 0 110px; overflow: hidden; background: radial-gradient(circle at 88% 9%, rgba(191,211,255,.72) 0 170px, transparent 171px), radial-gradient(circle at 73% 18%, rgba(255,221,153,.55) 0 115px, transparent 116px), linear-gradient(#f8f9fc, #eef2f8); }
  .page-content::before { content: ""; position: absolute; inset: 0; opacity: .38; pointer-events: none; background-image: linear-gradient(#e4e8ef 1px, transparent 1px), linear-gradient(90deg, #e4e8ef 1px, transparent 1px); background-size: 72px 72px; }
  .page-content > article { position: relative; z-index: 1; width: min(calc(100% - 64px), 1200px); margin: 0 auto; }
  .page-heading { max-width: 820px; }
  .eyebrow, .group-index, .publication-year { color: #536ca9; font-family: "IBM Plex Mono", monospace; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow { margin: 0 0 20px; }
  h1 { margin: 0; color: #1e2c43; font-size: clamp(52px, 8vw, 100px); font-weight: 400; line-height: 1; letter-spacing: -4px; }
  .lead { max-width: 650px; margin: 30px 0 8px; font-size: 20px; }
  .source-note { margin: 0; color: #69788e; font-size: 14px; }
  .section-nav { position: sticky; top: 0; z-index: 3; justify-content: flex-start; gap: 10px; margin: 58px 0 72px; padding: 12px 0; border-top: 1px solid #bcc9dd; border-bottom: 1px solid #bcc9dd; background: rgba(245,247,251,.88); backdrop-filter: blur(12px); }
  .section-nav a { padding: 4px 12px; border: 1px solid #aebdd5; border-radius: 999px; color: #40516a; font-size: 13px; }
  .section-nav a:hover { background: #e1e9f6; text-decoration: none; }
  .publication-group + .publication-group { margin-top: 88px; }
  .group-heading { display: flex; align-items: baseline; gap: 20px; margin-bottom: 18px; }
  .group-index { flex: 0 0 auto; }
  h2 { margin: 0; color: #1e2c43; font-size: clamp(28px, 4vw, 46px); font-weight: 500; line-height: 1.25; letter-spacing: -1px; }
  .publication-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid #bcc9dd; }
  .publication-item { display: grid; grid-template-columns: 80px 1fr; gap: 30px; padding: 28px 0 30px; border-bottom: 1px solid #d2dbe8; }
  .publication-year { padding-top: 4px; }
  .publication-body { max-width: 900px; }
  h3 { margin: 0 0 10px; color: #19263a; font-size: 21px; font-weight: 600; line-height: 1.5; }
  .authors, .venue { margin: 0; color: #4b5a70; font-size: 14px; }
  .venue { margin-top: 4px; color: #6c788b; font-style: italic; }
  .publication-link { display: inline-block; margin-top: 11px; font-family: "IBM Plex Mono", monospace; font-size: 12px; }
  footer { margin-top: 0; padding: 34px 0; border-top: 1px solid #263752; background: #151515; color: #b9c1ca; font-size: 13px; }
  .footer-wrapper { width: min(calc(100% - 64px), 1200px); margin: 0 auto; display: flex; justify-content: space-between; }
  @media (max-width: 720px) {
    .header-wrapper, .page-content > article, .footer-wrapper { width: min(calc(100% - 32px), 1200px); }
    .site-title { font-size: 17px; }
    .header-wrapper { min-height: 57px; }
    nav:not(.section-nav) { display: none; }
    .page-content { padding-top: 42px; }
    h1 { font-size: 56px; letter-spacing: -2px; }
    .lead { font-size: 17px; }
    .section-nav { margin: 42px 0 54px; overflow-x: auto; white-space: nowrap; }
    .publication-item { grid-template-columns: 1fr; gap: 5px; padding: 23px 0 26px; }
    .publication-year { padding-top: 0; }
    h3 { font-size: 18px; }
    .footer-wrapper { flex-direction: column; gap: 5px; }
  }
</style>
