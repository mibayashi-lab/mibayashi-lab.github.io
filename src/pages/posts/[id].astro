---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { siteData } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const postDate = post.data.date.toISOString().slice(0, 10);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={post.data.summary ?? post.data.title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{post.data.title} | {siteData.name}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">M</span>
          <span class="brand-copy"><strong>{siteData.name}</strong><small>{siteData.nameEn}</small></span>
        </a>
        <nav aria-label="メインナビゲーション">
          <a href="/#about">About</a><a href="/research/">Research</a><a href="/#projects">Themes</a><a href="/#members">Members</a><a href="/posts/">Posts</a><a class="nav-contact" href="/#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <article class="post shell">
        <a class="back" href="/posts/">← Posts</a>
        <header class="post-header">
          <div><time datetime={postDate}>{postDate.replaceAll('-', '.')}</time><span>{post.data.category}</span></div>
          <h1>{post.data.title}</h1>
          {post.data.summary && <p>{post.data.summary}</p>}
        </header>
        <div class="post-content"><Content /></div>
      </article>
    </main>

    <footer><div class="shell footer-inner"><strong>{siteData.name}</strong><span>{siteData.contact.email}</span></div></footer>
  </body>
</html>

<style>
  :root { --ink:#151515; --navy:#263752; --line:#cbd2dc; --shell:1200px; --sans:"Noto Sans JP","DM Sans",sans-serif; --latin:"DM Sans","Noto Sans JP",sans-serif; --mono:"IBM Plex Mono","Noto Sans JP",monospace; }
  * { box-sizing:border-box; }
  html { zoom:.9; background:#eef2f8; color:var(--ink); font-family:var(--sans); font-size:16px; line-height:1.85; }
  body { margin:0; font-size:17.78px; }
  a { color:inherit; text-decoration:none; }
  .shell { width:min(calc(100% - 48px),var(--shell)); margin-inline:auto; }
  .site-header { position:sticky; top:0; z-index:20; border-bottom:1px solid #becbe0; background:rgba(225,233,246,.94); backdrop-filter:blur(12px); }
  .header-inner { min-height:74px; display:flex; align-items:center; justify-content:space-between; gap:32px; }
  .brand { display:flex; align-items:center; gap:12px; }
  .brand-mark { display:grid; place-items:center; width:38px; height:38px; background:var(--navy); color:#fff; font:800 20px/1 var(--latin); }
  .brand-copy { display:flex; flex-direction:column; line-height:1.15; }
  .brand-copy strong { color:#1e2c43; font-size:17px; }
  .brand-copy small { margin-top:4px; color:#66758c; font:500 10px/1 var(--mono); letter-spacing:.1em; text-transform:uppercase; }
  nav { display:flex; align-items:center; gap:28px; font:500 18px/1 var(--latin); }
  nav a { color:#40516a; }
  nav .nav-contact { padding:12px 16px; border:1px solid var(--navy); background:var(--navy); color:#fff; }
  main { min-height:calc(100vh - 150px); padding:82px 0 120px; background:radial-gradient(circle at 88% 7%,rgba(191,211,255,.65) 0 150px,transparent 151px),linear-gradient(#f8f9fc,#eef2f8); }
  .post { max-width:900px; }
  .back { display:inline-block; margin-bottom:48px; color:#536ca9; font:500 13px/1 var(--mono); }
  .post-header { padding-bottom:42px; border-bottom:1px solid var(--line); }
  .post-header > div { display:flex; gap:18px; align-items:center; }
  time { color:#68768a; font:500 12px/1 var(--mono); }
  .post-header span { padding:6px 10px; background:#fff3bd; font:500 11px/1 var(--mono); }
  h1 { max-width:850px; margin:26px 0 20px; font-size:clamp(34px,5vw,62px); line-height:1.35; letter-spacing:-.04em; }
  .post-header p { max-width:720px; margin:0; color:#566171; font-size:17px; }
  .post-content { max-width:760px; padding:44px 0; font-size:17px; }
  .post-content :global(h2) { margin:2em 0 .7em; font-size:28px; }
  .post-content :global(h3) { margin:1.8em 0 .6em; font-size:22px; }
  .post-content :global(a) { color:#3f5f9f; text-decoration:underline; }
  .post-content :global(img) { max-width:100%; height:auto; }
  footer { padding:36px 0; background:#151515; color:#b9c1ca; }
  .footer-inner { display:flex; justify-content:space-between; gap:24px; font-size:13px; }
  @media (max-width:900px) { nav a:not(.nav-contact){display:none;} }
  @media (max-width:640px) { .shell{width:min(calc(100% - 32px),var(--shell));} main{padding:52px 0 84px;} .back{margin-bottom:34px;} .footer-inner{flex-direction:column;gap:4px;} }
</style>
